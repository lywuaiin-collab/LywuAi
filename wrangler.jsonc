{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lywuai",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/dist",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lywuai",
      "database_id": "ad616b58-1640-4b62-9b88-a8226eb35f2b"
    },
    {
      "binding": "MEDIA_DB",
      "database_name": "lywuai_media",
      "database_id": "a139aeb6-a191-4290-b111-16dc16182bae"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SESSION_SECRET": "lywuai-production-session-secret-at-least-32-bytes-change-this-in-production"
  }
}
